<?php
/**
 * @file
 * Adds Backdrop Icon API support to menu links.
 */

/**
 * Implements hook_library_info().
 */
function menu_icons_library_info() {
  $path = backdrop_get_path('module', 'menu_icons');

  $libraries['menu_icons.assets'] = array(
    'title' => 'Menu icon assets',
    'version' => '1.0',
    'css' => array(
      $path . '/css/menu_icon.css' => array(),
    ),
  );

  $libraries['menu_icons.picker'] = array(
    'title' => 'Menu icon picker',
    'version' => '1.0',
    'js' => array(
      $path . '/js/menu_icon_picker.js' => array(),
    ),
    'css' => array(
      $path . '/css/menu_icon_picker.css' => array(),
    ),
  );

  return $libraries;
}

/**
 * Implements hook_menu().
 */
function menu_icons_menu() {
  // Use a unique path to avoid collisions with contrib modules (e.g., icon_browser).
  $items['admin/structure/menu/menu-icon-browser'] = array(
    'page callback' => 'menu_icons_browser_json',
    // Icon listings are non-sensitive; allow all users to fetch the JSON.
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_output',
    'page arguments' => array(),
    'access arguments' => array(),
  );

  return $items;
}

/**
 * Implements hook_boot(). Ensure a theme key exists early in bootstrap.
 */
function menu_icons_boot() {
  menu_icons_ensure_theme_key();
}

/**
 * Ensure we have a usable theme key when icon() is invoked outside bootstrap.
 */
function menu_icons_ensure_theme_key() {
  if (!empty($GLOBALS['theme_key'])) {
    return $GLOBALS['theme_key'];
  }

  $config = config('system.core');
  $admin_theme = $config->get('admin_theme');
  $default_theme = $config->get('theme_default');

  // Prefer admin theme if configured; fall back to default theme.
  foreach (array($admin_theme, $default_theme) as $candidate) {
    if (!empty($candidate)) {
      $GLOBALS['theme_key'] = $candidate;
      return $candidate;
    }
  }

  // If theme system is available, pick any enabled theme as a last resort.
  if (function_exists('list_themes')) {
    $themes = list_themes();
    if (!empty($themes)) {
      $fallback = key($themes);
      $GLOBALS['theme_key'] = $fallback;
      return $fallback;
    }
  }

  return '';
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_edit_item().
 */
function menu_icons_form_menu_edit_item_alter(&$form, &$form_state) {
  $item = isset($form['original_item']['#value']) ? $form['original_item']['#value'] : array();
  $stored_icon = '';
  if (!empty($item['options']['menu_icon'])) {
    $icon_source = $item['options']['menu_icon'];
    $stored_icon = is_array($icon_source) && isset($icon_source['name']) ? (string) $icon_source['name'] : (string) $icon_source;
  }

  $form['menu_icon'] = array(
    '#type' => 'textfield',
    '#title' => t('Menu icon'),
    '#default_value' => $stored_icon,
    '#maxlength' => 128,
    '#description' => t('Optional. Enter the machine name of a Backdrop core icon (for example @example). Leave empty to show no icon.', array('@example' => 'house')),
    '#attributes' => array(
      'placeholder' => t('e.g. house'),
    ),
    '#weight' => 12,
    '#field_suffix' => '<button type="button" class="button button-secondary menu-icon-picker-launch" data-target="edit-menu-icon" data-endpoint="' . check_plain(base_path() . 'admin/structure/menu/menu-icon-browser') . '">' . t('Browse icons') . '</button>',
  );

  $form['#attached']['library'][] = array('menu_icons', 'menu_icons.assets');
  $form['#attached']['library'][] = array('menu_icons', 'menu_icons.picker');
  $form['#attached']['js'][] = array(
    'type' => 'setting',
    'data' => array(
      'menuIconPicker' => array(
        // Default endpoint; JS will prefer the per-button data-endpoint.
        'endpoint' => base_path() . 'admin/structure/menu/menu-icon-browser',
        'limit' => 40,
      ),
    ),
  );

  $form['#validate'][] = 'menu_icons_menu_edit_item_validate';
  // Run our submit handler before the core menu_edit_item_submit so the icon
  // value is present when the link is saved.
  if (!in_array('menu_icons_menu_edit_item_submit', $form['#submit'])) {
    array_unshift($form['#submit'], 'menu_icons_menu_edit_item_submit');
  }
}

/**
 * Validate the icon input on the menu item form.
 */
function menu_icons_menu_edit_item_validate($form, &$form_state) {
  if (!isset($form_state['values']['menu_icon'])) {
    return;
  }
  $icon = trim($form_state['values']['menu_icon']);
  $form_state['values']['menu_icon'] = $icon;

  if ($icon === '') {
    return;
  }

  if (!preg_match('/^[A-Za-z0-9_-]+$/', $icon)) {
    form_set_error('menu_icon', t('Icons may only contain letters, numbers, underscores, and hyphens.'));
    return;
  }

  if (!icon_get_path($icon)) {
    form_set_error('menu_icon', t('The icon "@icon" was not found in core, the active theme, or any enabled modules.', array('@icon' => $icon)));
  }
}

/**
 * Submit handler for menu icon support on menu_edit_item().
 */
function menu_icons_menu_edit_item_submit($form, &$form_state) {
  if (!isset($form_state['values']['menu_icon'])) {
    return;
  }
  $icon = trim($form_state['values']['menu_icon']);

  if ($icon === '') {
    if (isset($form_state['values']['options']['menu_icon'])) {
      unset($form_state['values']['options']['menu_icon']);
    }
    return;
  }

  if (!isset($form_state['values']['options']) || !is_array($form_state['values']['options'])) {
    $form_state['values']['options'] = array();
  }

  // Store the icon on the menu link options and allow translation alterations.
  $form_state['values']['options']['menu_icon'] = $icon;
  $form_state['values']['options']['alter'] = TRUE;

  // Ensure Admin Bar cache picks up icon changes immediately.
  _menu_icons_flush_admin_bar_cache();
}

/**
 * Implements hook_menu_link_insert().
 */
function menu_icons_menu_link_insert($link) {
  _menu_icons_flush_admin_bar_cache();
}

/**
 * Implements hook_menu_link_update().
 */
function menu_icons_menu_link_update($link) {
  _menu_icons_flush_admin_bar_cache();
}

/**
 * Implements hook_menu_link_delete().
 */
function menu_icons_menu_link_delete($link) {
  _menu_icons_flush_admin_bar_cache();
}

/**
 * Clear Admin Bar caches so icon changes show immediately.
 */
function _menu_icons_flush_admin_bar_cache() {
  if (module_exists('admin_bar')) {
    cache('admin_bar')->flush();
    backdrop_static_reset('admin_bar_cache_get');
  }
}

// Note: Backdrop does not implement hook_page_build; front-end assets are
// added via more targeted alters and preprocess functions elsewhere.

/**
 * Implements hook_form_FORM_ID_alter() for menu_overview_form.
 */
function menu_icons_form_menu_overview_form_alter(&$form, &$form_state, $form_id) {
  // Render icons inline in the menu overview table so admins can see them.
  foreach ($form as &$element) {
    if (!is_array($element) || empty($element['#item']['options']['menu_icon'])) {
      continue;
    }
    $item = $element['#item'];
    $icon_name = $item['options']['menu_icon'];
    $icon_name = is_array($icon_name) && isset($icon_name['name']) ? $icon_name['name'] : $icon_name;
    $icon_name = trim((string) $icon_name);
    if ($icon_name === '' || !icon_get_path($icon_name)) {
      continue;
    }

    // Rebuild the link with inline icon markup.
    $options = !empty($item['localized_options']) ? $item['localized_options'] : array();
    $options['html'] = TRUE;
    $options['attributes']['class'][] = 'has-menu-icon';
    $options['attributes']['class'][] = 'menu-icon-' . backdrop_clean_css_identifier($icon_name);
    $options['attributes']['data-menu-icon-path'] = icon_get_path($icon_name);

    $label = check_plain($item['title']);
    $icon_markup = icon($icon_name);
    $wrapped = '<span class="menu-icon-wrapper"><span class="menu-icon-glyph">' . $icon_markup . '</span><span class="menu-icon-label"> ' . $label . '</span></span>';

    $element['title']['#markup'] = l($wrapped, $item['href'], $options);
    backdrop_add_library('menu_icons', 'menu_icons.assets');
  }
}

/**
 * Implements hook_menu_tree_alter().
 *
 * Ensures front-end menus render icons inline (non-admin-bar menus).
 */
function menu_icons_menu_tree_alter(&$tree, $menu_name) {
  foreach ($tree as &$element) {
    if (!is_array($element) || empty($element['link']['options']['menu_icon'])) {
      // Recurse into children regardless.
      if (!empty($element['below'])) {
        menu_icons_menu_tree_alter($element['below'], $menu_name);
      }
      continue;
    }

    $link = &$element['link'];
    $icon_source = $link['options']['menu_icon'];
    $icon_name = is_array($icon_source) && isset($icon_source['name']) ? $icon_source['name'] : $icon_source;
    $icon_name = trim((string) $icon_name);
    $icon_path = icon_get_path($icon_name);
    if ($icon_name === '' || !$icon_path) {
      if (!empty($element['below'])) {
        menu_icons_menu_tree_alter($element['below'], $menu_name);
      }
      continue;
    }

    // Prepare classes and attributes.
    $icon_class = 'menu-icon-' . backdrop_clean_css_identifier($icon_name);

    // Make sure localized options exist.
    if (empty($link['localized_options'])) {
      $link['localized_options'] = $link['options'];
    }

    $link['localized_options']['attributes']['class'][] = 'has-menu-icon';
    $link['localized_options']['attributes']['class'][] = $icon_class;
    $link['localized_options']['attributes']['data-menu-icon-path'] = $icon_path;

    // Also add to raw options so later alters/theming see it.
    $link['options']['attributes']['class'][] = 'has-menu-icon';
    $link['options']['attributes']['class'][] = $icon_class;
    $link['options']['attributes']['data-menu-icon-path'] = $icon_path;

    // De-duplicate classes.
    foreach (array('localized_options', 'options') as $opt_key) {
      if (!empty($link[$opt_key]['attributes']['class'])) {
        $link[$opt_key]['attributes']['class'] = array_values(array_unique($link[$opt_key]['attributes']['class']));
      }
    }

    if (!empty($element['below'])) {
      menu_icons_menu_tree_alter($element['below'], $menu_name);
    }
  }
}

/**
 * Preprocess menu links to render icon markup for non-admin menus.
 */
function menu_icons_preprocess_menu_link(&$variables) {
  $element = &$variables['element'];

  // Skip Admin Bar; it renders icons via its own pipeline.
  if (!empty($element['#original_link']['menu_name']) && $element['#original_link']['menu_name'] === 'admin_bar') {
    return;
  }

  // Determine the icon name from the Icon API option or stored menu_icon.
  $icon_name = '';
  if (!empty($element['#localized_options']['icon'])) {
    $icon_name = $element['#localized_options']['icon'];
  }
  elseif (!empty($element['#original_link']['options']['menu_icon'])) {
    $src = $element['#original_link']['options']['menu_icon'];
    $icon_name = is_array($src) && isset($src['name']) ? $src['name'] : $src;
  }
  elseif (!empty($element['#attributes']['class'])) {
    foreach ($element['#attributes']['class'] as $cls) {
      if (strpos($cls, 'menu-icon-') === 0) {
        $icon_name = substr($cls, strlen('menu-icon-'));
        break;
      }
    }
  }

  $icon_name = trim((string) $icon_name);
  if ($icon_name === '') {
    return;
  }

  $icon_path = icon_get_path($icon_name);
  if (!$icon_path) {
    return;
  }

  // Avoid double wrapping if already processed.
  if (is_string($element['#title']) && strpos($element['#title'], 'menu-icon-wrapper') !== FALSE) {
    return;
  }

  $label = $element['#title'];
  if (empty($element['#localized_options']['html'])) {
    $label = check_plain($label);
  }

  $icon_markup = icon($icon_name);

  // Ensure HTML rendering and set attributes for styling/JS if needed.
  $element['#localized_options']['html'] = TRUE;
  $element['#localized_options']['attributes']['class'][] = 'has-menu-icon';
  $element['#localized_options']['attributes']['class'][] = 'menu-icon-' . backdrop_clean_css_identifier($icon_name);
  $element['#localized_options']['attributes']['data-menu-icon-path'] = $icon_path;

  if (!empty($element['#localized_options']['attributes']['class'])) {
    $element['#localized_options']['attributes']['class'] = array_values(array_unique($element['#localized_options']['attributes']['class']));
  }

  $element['#title'] = '<span class="menu-icon-wrapper"><span class="menu-icon-glyph">' . $icon_markup . '</span><span class="menu-icon-label"> ' . $label . '</span></span>';

  backdrop_add_library('menu_icons', 'menu_icons.assets');
}

/**
 * Page callback: JSON icon search endpoint.
 */
function menu_icons_browser_json() {
  // Avoid warnings in _icon_from_theme() when no theme has been initialized.
  menu_icons_ensure_theme_key();

  $limit = isset($_GET['limit']) ? (int) $_GET['limit'] : 40;
  $limit = max(1, min(100, $limit));
  $page = isset($_GET['page']) ? (int) $_GET['page'] : 0;
  $page = max(0, $page);
  // Use a dedicated search parameter; ignore 'q' which is used for path routing.
  $query = isset($_GET['search']) ? trim(backdrop_strtolower($_GET['search'])) : '';

  // Force rebuild to avoid stale/empty cache issues on this endpoint.
  $icons = menu_icons_get_all_names(TRUE);
  $debug_count = count($icons);
  $debug_sample = $debug_count ? array_slice($icons, 0, 3) : array();
  if ($query !== '') {
    $icons = array_values(array_filter($icons, function ($name) use ($query) {
      return strpos(backdrop_strtolower($name), $query) !== FALSE;
    }));
  }

  sort($icons, SORT_STRING);
  $total = count($icons);
  $offset = $page * $limit;
  $page_icons = array_slice($icons, $offset, $limit);

  $results = array();
  foreach ($page_icons as $name) {
    $results[] = array(
      'name' => $name,
      'markup' => icon($name),
    );
  }

  return array(
    'total' => $total,
    'count' => count($results),
    'page' => $page,
    'limit' => $limit,
    'results' => $results,
    'debug' => array('count_before_filter' => $debug_count, 'total_calculated' => $total, 'sample' => $debug_sample, 'query' => $query),
  );
}

/**
 * Build a cached list of available icon names.
 */
function menu_icons_get_all_names($rebuild = FALSE) {
  // Ensure a theme is available before looking for theme icons.
  menu_icons_ensure_theme_key();

  $cache = cache('cache')->get('menu_icons_all_names');
  if (!$rebuild && $cache && is_array($cache->data)) {
    return $cache->data;
  }

  $names = array();

  // Core icon set.
  $core_dir = BACKDROP_ROOT . '/core/misc/icons';
  $names = array_merge($names, menu_icons_names_from_directory($core_dir));

  // Active theme icons (if present).
  if (!empty($GLOBALS['theme_key'])) {
    $theme_dir = backdrop_get_path('theme', $GLOBALS['theme_key']) . '/icons';
    $names = array_merge($names, menu_icons_names_from_directory(BACKDROP_ROOT . '/' . $theme_dir));
  }

  // Module-provided icons via hook_icon_info().
  $icon_info = icon_get_info();
  if (!empty($icon_info)) {
    $names = array_merge($names, array_keys($icon_info));
  }

  $names = array_unique($names);
  sort($names, SORT_STRING);

  cache('cache')->set('menu_icons_all_names', $names, CACHE_TEMPORARY);

  return $names;
}

/**
 * Collect icon names from a directory of SVGs.
 */
function menu_icons_names_from_directory($directory) {
  $names = array();
  if (!is_dir($directory)) {
    return $names;
  }
  $files = file_scan_directory($directory, '/\.svg$/');
  foreach ($files as $file) {
    $names[] = basename($file->filename, '.svg');
  }
  return $names;
}

/**
 * Implements hook_translated_menu_link_alter().
 */
function menu_icons_translated_menu_link_alter(&$item, $map) {
  if (empty($item['options']['menu_icon'])) {
    return;
  }

  $icon_source = $item['options']['menu_icon'];
  $icon_name = is_array($icon_source) && isset($icon_source['name']) ? (string) $icon_source['name'] : (string) $icon_source;
  $icon_name = trim($icon_name);
  $icon_path = icon_get_path($icon_name);
  if ($icon_name === '' || !$icon_path) {
    return;
  }
  $icon_class = 'menu-icon-' . backdrop_clean_css_identifier($icon_name);

  // Use the Icon API option so the renderer outputs the icon inline.
  $item['localized_options']['icon'] = $icon_name;
  $item['localized_options']['attributes']['class'][] = 'has-menu-icon';
  $item['localized_options']['attributes']['class'][] = $icon_class;
  $item['localized_options']['attributes']['data-menu-icon-path'] = $icon_path;

  // De-duplicate classes in case other modules added their own.
  if (!empty($item['localized_options']['attributes']['class'])) {
    $item['localized_options']['attributes']['class'] = array_values(array_unique($item['localized_options']['attributes']['class']));
  }

  backdrop_add_library('menu_icons', 'menu_icons.assets');
}

